#!/usr/bin/env python3
"""Plot a panel plot of maps showing a variable geographical distribution.

Usage: bin/plot_map mean|trend|diff VAR SEASON START1 END1 [START2 END2] INPUT SOURCE... OUTPUT
       bin/plot_map diff_multi VAR SEASON NPERIODS NSOURCES [START END]... [INPUT SOURCE]... OUTPUT

Arguments:

  TYPE	    Plot type. One of: "mean" (period mean), "trend" (period linear trend), "diff" (period difference), or "diff_multi" (period difference with multiple periods and scenarios)
  VAR	    Variable name.
  SEASON    Season.
  START1    Start year (first period).
  END1	    End year (first period).
  START2    Start year (second period) if the plot type is "diff".
  END2	    End year (second period) if the plot type is "diff".
  INPUT     Input directory with period-season statistics produced by calc_stats (NetCDF).
  SOURCE    Source name.
  OUTPUT    Output directory (PDF).
  NPERIODS  Number of periods.
  NSOURCES  Number of sources.
  START     Start year.
  END       End year.
"""

import signal

signal.signal(signal.SIGINT, signal.SIG_DFL)

import os
import string
import sys
import warnings
from concurrent.futures import ProcessPoolExecutor, as_completed
from copy import copy

import cartopy.crs as ccrs
import cartopy.feature as cfeature
import cartopy.util
import cmcrameri.cm as cmc
import ds_format as ds
import matplotlib as mpl
import matplotlib.pyplot as plt
import matplotlib.ticker as mticker
import numpy as np
import scipy as sp
from lib import io, misc
from matplotlib.gridspec import GridSpec
from matplotlib.lines import Line2D
from matplotlib.patches import Rectangle
from pyproj import CRS
from pyproj.transformer import transform

misc.load_mpl_fonts()

mpl.rc("font", family="Open Sans")
mpl.rc("axes", linewidth=0.3)
mpl.rc("axes", grid=True)
mpl.rc("lines", linewidth=1.2)
mpl.rc("xtick.major", width=0.3)
mpl.rc("ytick.major", width=0.3)
mpl.rc("legend", framealpha=1)
mpl.rc("legend", facecolor="none")
mpl.rc("legend", edgecolor="none")
mpl.rc("legend", fancybox=False)
mpl.rc("legend", fontsize=9)
mpl.rc("grid", color="k")
mpl.rc("grid", alpha=0.2)
mpl.rc("grid", lw=0.1)
mpl.rc("hatch", linewidth=0.05)
mpl.rc("hatch", color="#000000a0")

SIG_LEVEL = 0.05  # Statistical significance level

# Only consider latitudes above this number when determining value limits.
VLIM_CUTOFF_LAT = 37.4  # Exclude Africa

MARGIN = 0.7  # in
PANEL_WIDTH = 1.413  # in
PANEL_HEIGHT = 1.8  # in

LCC_PROJECTION = {
	"false_easting": 2925000,
	"false_northing": 2925000,
	"central_latitude": 49.5,
	"central_longitude": 10.5,
	"standard_parallels": [49.5],
}

COLOR_SHADING = "#DDDDDD"
COLOR_HIGHLIGHT = "#71f4ff"


def get_vlim(x, sym=False, percentile=2, mask=None):
	if isinstance(x, np.ma.MaskedArray):
		x = x.filled(np.nan)
	if mask is not None:
		x = x.copy()
		if mask.ndim == 2:
			x[~mask] = np.nan
		else:
			x[:, ~mask] = np.nan
	low = np.nanpercentile(x, percentile)
	high = np.nanpercentile(x, 100 - percentile)
	if sym:
		y = max(abs(low), abs(high))
		return [-y, y]
	else:
		return [low, high]


def get_bounds_cmap(var, relative, vlim):
	locator = mpl.ticker.MaxNLocator(nbins=16, steps=[1, 2, 2.5, 5, 10])
	bounds = locator.tick_values(vlim[0], vlim[1])
	n = len(bounds) - 1
	if relative:
		cmap = plt.get_cmap("Spectral_r", n).copy()
		cmap.set_over("#600027")
		cmap.set_under("#322a56")
	else:
		cmap = plt.get_cmap("rainbow", n).copy()
		cmap.set_over("#8d0000")
		cmap.set_under("#44008c")
	if var == "pr":
		cmap = cmap.reversed()
	return bounds, cmap


def get_group_bounds_cmap(dd, var, relative, percentile=2):
	vlim = [np.inf, -np.inf]
	for d in dd:
		mask = d["lat"] >= VLIM_CUTOFF_LAT
		if relative:
			vlim1 = get_vlim(d["z"], True, percentile, mask=mask)
			y = max(vlim[1], vlim1[1])
			vlim = [-y, y]
		else:
			vlim1 = get_vlim(d["z"], False, mask=mask)
			vlim = [min(vlim[0], vlim1[0]), max(vlim[1], vlim1[1])]
	return get_bounds_cmap(var, relative, vlim)


def get_panel_title(d):
	title = misc.get_source_title(ds.attrs(d))
	if title == "HC(EC-Earth3-Veg)":
		return (
			title[:-1] + "-" + ds.attr(d, "driving_variant_label")[:2] + title[-1]
		)
	elif title == "EC-Earth3-Veg":
		return title + "-" + ds.attr(d, "variant_label")[:2]
	else:
		return title


def init_crs(crs):
	return ccrs.LambertConformal(
		central_longitude=crs["longitude_of_central_meridian"],
		central_latitude=crs["latitude_of_projection_origin"],
		false_easting=crs["false_easting"],
		false_northing=crs["false_northing"],
		standard_parallels=(crs["standard_parallel"],),
	)


def init_map(subplot, crs_attrs, xaxis=True, yaxis=True):
	if crs_attrs != {}:
		crs = init_crs(crs_attrs)
		data_crs = crs
	else:
		crs = ccrs.LambertConformal(**LCC_PROJECTION)
		data_crs = ccrs.PlateCarree()

	ax = plt.gcf().add_subplot(subplot, projection=crs)
	ax.set_extent([-10, 30, 33, 75], crs=ccrs.PlateCarree())
	ax.coastlines("50m", linewidth=0.4, alpha=0.9)
	ax.add_feature(cfeature.BORDERS, linewidth=0.3, edgecolor="black", alpha=0.8)

	gl = ax.gridlines(
		draw_labels=True,
		linewidth=0.5,
		alpha=0.1,
		color="k",
		x_inline=False,
		y_inline=False,
		rotate_labels=False,
	)
	gl.xlocator = mticker.FixedLocator(np.arange(-180, 180 + 10, 10))
	gl.ylocator = mticker.FixedLocator(np.arange(-90, 90 + 5, 5))
	gl.top_labels = False
	gl.right_labels = False
	if not xaxis:
		gl.bottom_labels = False
	if not yaxis:
		gl.left_labels = False
	gl.xlabel_style = {"size": 8}
	gl.ylabel_style = {"size": 8}

	return ax, crs, data_crs


def create_cb_axes_generic(nrows, ncols, pos, offset):
	shrink = 0 if pos == 0 else 0.2
	vert_offset = 0 if pos == 0 else PANEL_HEIGHT
	loc = [
		MARGIN + PANEL_WIDTH * pos + shrink,
		0.3 - offset * 0.3 + vert_offset,
		PANEL_WIDTH * (ncols - pos) - shrink,
		0.1,
	]
	fw, fh = plt.gcf().get_size_inches()
	loc = np.array(loc) / np.array([fw, fh, fw, fh])
	return plt.gcf().add_axes(loc)


def create_cb_axes_diff_multi(nrows, ncols, pos):
	loc = [
		MARGIN + PANEL_WIDTH * ncols + 0.15 + pos * 0.7,
		MARGIN,
		0.1,
		PANEL_HEIGHT * nrows,
	]
	fw, fh = plt.gcf().get_size_inches()
	loc = np.array(loc) / np.array([fw, fh, fw, fh])
	return plt.gcf().add_axes(loc)


def plot_cb(cax, var, bounds, cmap, label, units_pretty, rel, vertical=False):
	extend = "max" if (var == "pr" and bounds[0] == 0) else "both"
	if var == "psl" and not rel:
		fmt = mpl.ticker.FuncFormatter(lambda x, pos: f"{int(x) % 100:2d}")
		units_pretty = units_pretty + "; last two digits"
	elif var == "pr" and rel:
		fmt = mpl.ticker.FuncFormatter(
			lambda x, pos: f"{100 * (np.exp(x) - 1):.0f}"
		)
	else:
		fmt = mpl.ticker.FuncFormatter(
			lambda x, pos: f"{x:.10f}".rstrip("0").rstrip(".")
		)
	norm = mpl.colors.BoundaryNorm(bounds, len(bounds) - 1)
	cb = plt.gcf().colorbar(
		mpl.cm.ScalarMappable(norm=norm, cmap=cmap),
		cax=cax,
		orientation=("vertical" if vertical else "horizontal"),
		extend=extend,
		ticks=bounds,
		format=fmt,
	)
	cb_label = label
	if units_pretty != "":
		cb_label += " (%s)" % units_pretty
	cb.set_label(cb_label, fontsize=9)
	cb.ax.tick_params(labelsize=8)


def plot_legend(type_, pos, offset, layout):
	fw, fh = plt.gcf().get_size_inches()
	shrink = 0 if pos == 0 else 0.2  # in
	vert_offset = 0 if pos == 0 else PANEL_HEIGHT + 0.2  # in
	if pos == 0:
		bbox_to_anchor = [0.5, (-offset * 0.61 + 0.45) / fh]
		loc = "upper center"
	else:
		bbox_to_anchor = [
			MARGIN + PANEL_WIDTH * pos + shrink,
			0.15 - offset * 0.61 + vert_offset,
		]
		bbox_to_anchor = np.array(bbox_to_anchor) / np.array([fw, fh])
		loc = "upper left"

	noens = Rectangle((0, 0), 1, 1, facecolor=COLOR_SHADING, edgecolor="none")
	ens = Rectangle((0, 0), 1, 1, facecolor=COLOR_HIGHLIGHT, edgecolor="none")
	notrobust = (Line2D([0, 1], [1, 0], color="k"),)
	conflicting = (
		Line2D([0, 1], [1, 0], color="k"),
		Line2D([0, 1], [0, 1], color="k"),
	)
	nonsig = (
		Line2D([0.25, 0.75], [0.75, 0.25], color="k"),
		Line2D([0.25, 0.75], [0.25, 0.75], color="k"),
	)

	handles = [noens, ens]
	labels = ["Not in ensemble", "Ensemble"]
	if type_ == "diff":
		handles += [notrobust, conflicting]
		labels += ["No change or no robust signal", "Conflicting signals"]
	handles += [nonsig]
	labels += ["Non-significant " + ("trend" if type_ == "trend" else "anomaly")]

	plt.gcf().legend(
		handles,
		labels,
		handler_map={tuple: misc.SquareHandlerTuple(ndivide=None)},
		bbox_to_anchor=bbox_to_anchor,
		loc=loc,
		handletextpad=0.5,
		columnspacing=1,
		fontsize=8,
		ncols=(len(handles) if layout == "horizontal" else 1),
		borderpad=0,
		borderaxespad=0,
	)


def plot_hatching(marker, ind, source_coordinates, lon, lat, x, y, crs):
	if source_coordinates == "lonlat":
		xmin, xmax, ymin, ymax = plt.gca().get_extent()
		x = np.arange(xmin, xmax + 100000, 100000)
		y = np.arange(ymin, ymax + 100000, 100000)
		xg, yg = np.meshgrid(x, y)
		xg = xg.flatten()
		yg = yg.flatten()
		lonlat = ccrs.PlateCarree().transform_points(crs, xg, yg)
		long = lonlat[:, 0] % 360
		latg = lonlat[:, 1]
		ii = np.searchsorted(lon, long)
		jj = np.searchsorted(lat, latg)
		ii[ii >= len(lon)] = len(lon) - 1
		jj[jj >= len(lat)] = len(lat) - 1
		mask = ind[ii, jj]
	else:
		x2 = np.arange(np.min(x), np.max(x) + 100000, 100000)
		y2 = np.arange(np.min(y), np.max(y) + 100000, 100000)
		xg, yg = np.meshgrid(x2, y2)
		ii = np.searchsorted(x, x2)
		jj = np.searchsorted(y, y2)
		ii[ii >= len(x)] = len(x) - 1
		jj[jj >= len(y)] = len(y) - 1
		mask = ind[ii,][:, jj]
	mpl_marker, s = {
		"x": ["x", 4],
		"X": ["x", 7],
		"\\": [[(-0.5, 0.5), (0.5, -0.5)], 7],
	}[marker]
	plt.scatter(
		xg[mask],
		yg[mask],
		s=s,
		lw=0.1,
		color="k",
		marker=mpl_marker,
		transform=crs,
	)


def plot_panel_title(title, highlight=False):
	plt.text(
		0.009,
		0.992,
		title,
		transform=plt.gca().transAxes,
		bbox=dict(
			facecolor=(COLOR_HIGHLIGHT if highlight else COLOR_SHADING),
			edgecolor="none",
			boxstyle="square,pad=0.1",
			alpha=0.9,
		),
		fontsize=8,
		fontweight=("bold" if title == "ENS" else "normal"),
		ha="left",
		va="top",
	)


def plot_panel_data(z, extent, cmap, bounds, data_crs):
	im = plt.imshow(
		z,
		extent=extent,
		origin="lower",
		cmap=cmap,
		vmin=bounds[0],
		vmax=bounds[-1],
		interpolation="none",
		transform=data_crs,
	)


def plot_panel(
	subplot,
	d,
	name,
	xaxis=True,
	yaxis=True,
	bounds=None,
	cmap=None,
	highlight=False,
	title=None,
):
	figsize = plt.gcf().get_size_inches()
	attrs = ds.attrs(d, name)
	ax, crs, data_crs = init_map(subplot, ds.attrs(d, "crs"), xaxis, yaxis)

	if "x" in d and "y" in d:
		source_coordinates = "xy"
		x = d["x"]
		y = d["y"]
		z = d["z"]
		lon = None
		lat = None
		extent = [x[0], x[-1], y[0], y[-1]]
	else:
		source_coordinates = "lonlat"
		lon = d["lon"]
		lat = d["lat"]
		x = None
		y = None
		order = np.argsort(lon)
		z = d["z"][order, :]
		lon = lon[order]
		dlon = lon[1] - lon[0]
		dlat = lat[1] - lat[0]
		extent = [
			lon[0] - dlon,
			lon[-1] + dlon,
			lat[0] - dlat,
			lat[-1] + dlat,
		]
		z = z.T
		z, _ = cartopy.util.add_cyclic_point(z, coord=lon)

	plot_panel_data(z, extent, cmap, bounds, data_crs)
	if name + "_p" in d:
		plot_hatching(
			"x",
			d[name + "_p"] >= SIG_LEVEL,
			source_coordinates,
			lon,
			lat,
			x,
			y,
			crs,
		)
	if "robust_sign" in d and "robust_variability" in d:
		plot_hatching(
			"\\",
			~d["robust_variability"],
			source_coordinates,
			lon,
			lat,
			x,
			y,
			crs,
		)
		plot_hatching(
			"X",
			d["robust_variability"] & ~d["robust_sign"],
			source_coordinates,
			lon,
			lat,
			x,
			y,
			crs,
		)
	plot_panel_title(title, d.get("panel_highlight", False))


def read(input_, sources, var, name, season, period, index=None):
	dd = []
	vars = [
		name,
		name + "_p",
		name + "_ts",
		var + "_trend",
		"year",
		"x",
		"y",
		"lon",
		"lat",
		"crs",
	]
	if not isinstance(sources, list):
		sources = [sources]
		collapse = True
	else:
		collapse = False
	for i, source in enumerate(sources):
		desc = misc.parse_source(source)
		desc.update(
			{
				"variable_id": var,
				"season": season,
				"start_year": period[0],
				"end_year": period[1],
			}
		)

		if (
			source == "EUR-12lcc_REAN_rean_r1i1p1f1_ECMWF_CERRA-Land_v1-r1"
			and var != "pr"
			or source == "EUR-12lcc_REAN_rean_r1i1p1f1_ECMWF_CERRA_v1-r1"
			and var == "pr"
		):
			continue

		dd1 = io.read_dataset(input_, desc, vars, False, req_one=True, index=index)
		d = dd1[0]
		dd += [d]
	return dd[0] if collapse else dd


def is_gcm(d):
	attrs = ds.attrs(d)
	return "driving_source_id" not in attrs or attrs["driving_source_id"] not in [
		"OBS",
		"REAN",
		"ERA5",
	]


def calc_pvalue(d, d_ref, name, paired=True):
	mask = ~d_ref[name].mask
	pvalue = np.full(d[name].shape, np.nan)
	test = (
		sp.stats.ttest_rel
		if paired
		else lambda *args, **kwargs: sp.stats.ttest_ind(
			*args, **kwargs, equal_var=False
		)
	)
	with warnings.catch_warnings():
		warnings.simplefilter("ignore", category=RuntimeWarning)
		_, pvalue_m = test(
			d[name + "_ts"][:, mask], d_ref[name + "_ts"][:, mask], axis=0
		)
	pvalue[mask] = pvalue_m
	return pvalue


def calc_pvalue_parallel(dd1, dd2, name, paired=True):
	with ProcessPoolExecutor() as ex:
		futures = []
		for d1, d2 in zip(dd1, dd2):
			futures += [ex.submit(calc_pvalue, d1, d2, name, paired)]
		for future in as_completed(futures):
			res = future.result()
			if res is not None:
				i = futures.index(future)
				dd1[i][name + "_p"] = res


def calc_detrended_sd(year, z, z_trend):
	return np.std(z - z_trend * (year[:, None, None] - year[0]), axis=0)


def calc_robust_signal(year, mean, trend, diff):
	"""Calculate model signal robustness as defined in IPCC AR6 Cross-Chapter
	Box Atlas.1 | Displaying Robustness and Uncertainty in Maps.

	Arguments:
	                year - years corresponding to xx1
	                mean - fields for the "modern"(reference) time period
	                trend - trend in the "modern" (reference) field
	                diff - fields for the future (deviation) as anomalies from mean

	Returns:
	                robust_sign - field signifying where at least 80% of models agree on the
	                                                                  sign of change
	                robust_variability - field signifying where at least 66% of models show
	                                                                                                 greater change that the variability in the "modern"
	                                                                                                 time period
	"""
	# Sign agreement condition.
	positive = np.array([x > 0 for x in diff])
	positive_frac = np.mean(positive, axis=0)
	robust_sign = (positive_frac >= 0.8) | (positive_frac < 0.2)

	# Variability greater than threshold.
	std_1yr = [calc_detrended_sd(year, x, y) for x, y in zip(mean, trend)]
	nyears = len(year)
	gamma = [np.sqrt(2 / nyears) * 1.645 * x for x in std_1yr]
	greater = np.array([np.abs(x) > g for x, g in zip(diff, gamma)])
	greater_frac = np.mean(greater == 1, axis=0)
	robust_variability = greater_frac >= 0.66

	return robust_sign, robust_variability


def get_scenario(attrs):
	if "driving_experiment_id" in attrs:
		s = attrs["driving_experiment_id"].split("+")[-1].upper()
		if s.startswith("SSP"):
			return "SSP%s-%s.%s" % (s[3], s[4], s[5])
		return s


def get_title(type_, var_label, season, period, scenario):
	if type_ == "diff":
		return "%s in %s %d–%d and %d–%d (%s) relative to %d–%d" % (
			var_label,
			season,
			period[0][0],
			period[0][1],
			period[1][0],
			period[1][1],
			scenario,
			period[0][0],
			period[0][1],
		)
	else:
		return "%s in %s %d–%d" % (
			var_label,
			season,
			period[0],
			period[1],
		)


def get_file_name(var, season, periods):
	s = "%s_%s" % (var, season)
	for period in periods:
		s += "_%d-%d" % (period[0], period[1])
	return s
	s += ".pdf"
	return s


def get_ens_members(dd):
	d_ens = None
	for d in dd:
		if ds.attr(d, "source_id") == "ENS":
			d_ens = d
	members = ds.attr(d_ens, "ensemble_members") if d_ens is not None else []
	return [s.removesuffix("_mon") for s in members]


def get_ref(type_, dd, var):
	if var == "psl":
		try:
			return [d for d in dd if ds.attr(d, "source_id") == "ERA5"][0]
		except IndexError:
			return dd[0]
	else:
		return dd[0]


def get_ens(dd):
	for d in dd:
		if get_panel_title(d) == "ENS":
			return d


def init_figure(nrows, ncols):
	figsize = [
		2 * MARGIN + ncols * PANEL_WIDTH,
		2 * MARGIN + nrows * PANEL_HEIGHT,
	]
	fig = plt.figure(figsize=figsize)
	fw, fh = figsize
	gs = GridSpec(
		nrows,
		ncols,
		hspace=0,
		wspace=0,
		bottom=(MARGIN / fh),
		top=(1 - MARGIN / fh),
		left=(MARGIN / fw),
		right=((MARGIN + ncols * PANEL_WIDTH) / fw),
	)
	return gs


def calc_relative(z1, z2, var, units):
	if var == "pr":
		# z = (z1 - z2) / z2 * 100
		with warnings.catch_warnings():
			warnings.simplefilter("ignore", category=RuntimeWarning)
			z = np.log(z1 / z2)
		units = "%"
	else:
		z = z1 - z2
		z, units = misc.convert_pretty_units(z, units)
	return z, units


def source_intersection(dd1, dd2):
	dict1 = {get_panel_title(d): d for d in dd1}
	dict2 = {get_panel_title(d): d for d in dd2}
	sources = [s for s in dict1 if s in dict2]
	return [dict1[s] for s in sources], [dict2[s] for s in sources]


def plot_panels(gs, dd, name, bounds_abs, bounds_rel, cmap_abs, cmap_rel):
	for i, d in enumerate(dd):
		row = i // gs.ncols
		col = i % gs.ncols
		relative = "z_raw" in d
		bounds = bounds_rel if relative else bounds_abs
		cmap = cmap_rel if relative else cmap_abs
		letter = string.ascii_lowercase[i]
		title = "(%s)" % letter
		if "panel_title" in d:
			title += " " + d["panel_title"]
		plot_panel(
			gs[i],
			d,
			name,
			xaxis=(row == gs.nrows - 1 and col == 0),
			yaxis=(row == gs.nrows - 1 and col == 0),
			bounds=bounds,
			cmap=cmap,
			highlight=d.get("highlight", False),
			title=title,
		)
		if "xaxis_label" in d:
			plt.gca().text(
				0.5,
				1.02,
				d["xaxis_label"],
				transform=plt.gca().transAxes,
				ha="center",
				va="bottom",
				fontsize=9,
			)
		if "yaxis_label" in d:
			plt.gca().text(
				-0.35,
				0.5,
				d["yaxis_label"],
				transform=plt.gca().transAxes,
				rotation=90,
				ha="left",
				va="center",
				fontsize=9,
			)


def savefig(output, file, title):
	filename = os.path.join(output, file + ".pdf")
	plt.savefig(filename, bbox_inches="tight")
	print("-> %s" % filename)


def plot_diff_multi(
	type_, inputs, sources, output, var, name, season, periods, indexes
):
	dd = []
	for i, (input_, source, index) in enumerate(zip(inputs, sources, indexes)):
		d_row_ref = None
		for j, period in enumerate(periods):
			d = read(input_, source, var, name, season, period, index)
			units = ds.attr(d, "units", var=name)
			ens_members = ds.attr(d, "ensemble_members")
			d["dd_ens"] = [
				read(input_, member, var, name, season, period, index)
				for member in ens_members
			]
			if j == 0:
				d_row_ref = d
				d["z"], units = misc.convert_pretty_units(d[name], units)
				has_abs = True
				units_pretty_abs = misc.get_pretty_units(units)
			else:
				d["z_raw"] = d[name] - d_row_ref[name]
				d["z"], units = calc_relative(d[name], d_row_ref[name], var, units)
				has_rel = True
				units_pretty_rel = misc.get_pretty_units(units)
				for d_ens, d_ens_ref in zip(d["dd_ens"], d_row_ref["dd_ens"]):
					d_ens["z_raw"] = d_ens[name] - d_ens_ref[name]
				d["robust_sign"], d["robust_variability"] = calc_robust_signal(
					d["year"],
					[d_ens[f"{name}_ts"] for d_ens in d["dd_ens"]],
					[d_ens[f"{var}_trend"] for d_ens in d["dd_ens"]],
					[d_ens["z_raw"] for d_ens in d["dd_ens"]],
				)
			if i == 0:
				d["xaxis_label"] = "%d–%d" % (period[0], period[1])
			if j == 0:
				exp = d["."]["."]["driving_experiment_id"]
				d["yaxis_label"] = {
					"historical+ssp126": "SSP1-2.6",
					"historical+ssp370": "SSP3-7.0",
				}.get(exp, exp)
			ds.attr(d, "units", units, var="z")
			dd += [d]

	d_ref = dd[0]
	dd_rel = [d for d in dd if "z_raw" in d]
	percentile = 15 if var == "pr" else 2
	bounds_abs, cmap_abs = get_group_bounds_cmap([d_ref], var, False, percentile)
	bounds_rel, cmap_rel = get_group_bounds_cmap(dd_rel, var, True, percentile)

	n = len(dd)
	ncols = len(periods)
	nrows = len(inputs)
	gs = init_figure(nrows, ncols)
	plot_panels(gs, dd, name, bounds_abs, bounds_rel, cmap_abs, cmap_rel)

	label_abs = misc.get_pretty_var_label(ds.attr(d_ref, "long_name", var=name))
	label_rel = "Anomaly from %d–%d" % (periods[0][0], periods[0][1])

	letters_abs = [string.ascii_lowercase[i] for i in range(0, n, ncols)]
	letters_abs = "(" + ", ".join(letters_abs) + ")"
	letters_rel = [
		"%s–%s"
		% (
			string.ascii_lowercase[i * ncols + 1],
			string.ascii_lowercase[(i + 1) * ncols - 1],
		)
		for i in range(nrows)
	]
	letters_rel = "(" + ", ".join(letters_rel) + ")"

	cax_abs = create_cb_axes_diff_multi(nrows, ncols, 0)
	cax_rel = create_cb_axes_diff_multi(nrows, ncols, 1)

	plot_cb(
		cax_abs,
		var,
		bounds_abs,
		cmap_abs,
		letters_abs + " " + label_abs,
		units_pretty_abs,
		False,
		True,
	)
	plot_cb(
		cax_rel,
		var,
		bounds_rel,
		cmap_rel,
		letters_rel + " " + label_rel,
		units_pretty_rel,
		True,
		True,
	)

	title = "%s ensemble mean" % season
	plt.suptitle(
		title, y=(1 - 0.5 * MARGIN / plt.gcf().get_size_inches()[1]), fontsize=9
	)

	file = get_file_name(var, season, periods)
	savefig(output, file, title)


def plot_generic(
	type_, inputs, sources, output, var, name, season, periods, indexes
):
	has_abs = False
	has_rel = False
	if type_ == "diff":
		dd1 = read(
			inputs[0],
			sources,
			var,
			name,
			season,
			periods[0],
			index=indexes[0],
		)
		dd2 = read(
			inputs[0],
			sources,
			var,
			name,
			season,
			periods[1],
			index=indexes[0],
		)
		dd1, dd2 = source_intersection(dd1, dd2)
		dd1 = [copy(dd1[0])] + dd1
		dd2 = [copy(dd2[0])] + dd2
		d_ref = dd[0]
		d_ens = dd[1]
		dd = []
		for d1, d2 in zip(dd1, dd2):
			d = d1
			units = ds.attr(d1, "units", var=name)
			if d1 is d_ref:
				d["z"], units = misc.convert_pretty_units(d1[name], units)
				has_abs = True
				units_pretty_abs = misc.get_pretty_units(units)
			else:
				d["z_raw"] = d2[name] - d1[name]
				d["z"], units = calc_relative(d2[name], d1[name], var, units)
				has_rel = True
				units_pretty_rel = misc.get_pretty_units(units)
			ds.attr(d, "units", units, var="z")
			dd += [d]
	else:
		dd = read(inputs[0], sources, var, name, season, periods[0], index=index)
		d_ref = get_ref(type_, dd1, var)
		d_ens = get_ens(dd1)
		for d in dd:
			if type_ == "trend":
				units = ds.attr(d, "units", var=name)
				d["z"], units = misc.convert_pretty_units(d[name], units)
				has_rel = True
				units_pretty_rel = misc.get_pretty_units(units)
			elif d is d_ref:
				units = ds.attr(d, "units", var=name)
				d["z"], units = misc.convert_pretty_units(d[name], units)
				has_abs = True
				units_pretty_abs = misc.get_pretty_units(units)
			else:
				units = ds.attr(d, "units", var=name)
				d["z"], units = calc_relative(d[name], d_ref[name], var, units)
				d["z_raw"] = d[name] - d_ref[name]
				has_rel = True
				units_pretty_rel = misc.get_pretty_units(units)
			ds.attr(d, "units", units, var="z")
			dd += [d]

	ens_members = get_ens_members(dd)
	dd = [d_ref] + [d for d in dd if d is not d_ref]

	for i, d in enumerate(dd):
		source = misc.get_source_name(ds.attrs(d))
		d["panel_highlight"] = source in ens_members or title == "ENS"
		d["panel_title"] = get_panel_title(d)
		if type_ == "diff" and i == 0:
			d["panel_title"] += " " + ds.attr(d, "period").replace("-", "–")

	dd_rel = dd[1:]
	dd_ens = [d for d in dd if misc.get_source_name(ds.attrs(d)) in ens_members]

	if type_ == "mean":
		paired = [not is_gcm(d) for d in dd_rel]
		calc_pvalue_parallel(dd_rel, [d_ref] * len(dd_rel), name, paired=paired)
	elif type_ == "diff":
		calc_pvalue_parallel(dd1[2:], dd2[2:], name, paired=False)
		d_ens["robust_sign"], d_ens["robust_variability"] = calc_robust_signal(
			d_ref["year"],
			[d[f"{name}_ts"] for d in dd_ens],
			[d[f"{var}_trend"] for d in dd_ens],
			[d["z_raw"] for d in dd_ens],
		)

	percentile = 15 if var == "pr" or type_ == "diff" else 2
	if has_abs:
		bounds_abs, cmap_abs = get_group_bounds_cmap(
			[d_ref], var, False, percentile
		)
	if has_rel:
		bounds_rel, cmap_rel = get_group_bounds_cmap(dd_rel, var, True, percentile)

	n = len(dd)
	ncols = 4
	nrows = int(np.ceil(n / ncols))
	gs = init_figure(nrows, ncols)
	plot_panels(gs, dd, bounds_abs, bounds_rel, cmap_abs, cmap_rel)

	label_abs = misc.get_pretty_var_label(ds.attr(d_ref, "long_name", var=name))
	cb_offset_abs = 0
	if type_ == "trend":
		label_rel = label_abs
		cb_offset_rel = 0
	else:
		if type_ == "diff":
			label_rel = "%d–%d relative to %d–%d" % (
				periods[1][0],
				periods[1][1],
				periods[0][0],
				periods[0][1],
			)
		else:
			label_rel = "Anomaly from %s" % misc.get_source_title(ds.attrs(d_ref))
		cb_offset_rel = 2

	letters_abs = "(a)"
	letters_rel = "(b–" + string.ascii_lowercase[len(dd) - 1] + ")"

	k = len(dd) % ncols
	cb_pos = k if k == 1 else 0
	legend_pos = k if k == 2 or k == 1 and type_ != "diff" else 0
	legend_layout = "vertical" if k == 2 else "horizontal"
	ncolorbars = has_abs + has_rel
	legend_offset = ncolorbars if legend_pos == cb_pos else 0

	if has_abs:
		cax = create_cb_axes_generic(nrows, ncols, cb_pos, cb_offset_abs)
		plot_cb(
			cax,
			var,
			bounds_abs,
			cmap_abs,
			letters_abs + " " + label_abs,
			units_pretty_abs,
			False,
		)
	if has_rel:
		cax = create_cb_axes_generic(nrows, ncols, cb_pos, cb_offset_rel)
		plot_cb(
			var,
			bounds_rel,
			cmap_rel,
			(letters_rel + " " if has_abs else "") + label_rel,
			units_pretty_rel,
			True,
		)
	plot_legend(type_, legend_pos, legend_offset, legend_layout)
	title = get_title(
		type_, label_abs, season, periods, get_scenario(ds.attrs(d_ref))
	)
	plt.suptitle(
		title, y=(1 - 0.7 * MARGIN / plt.gcf().get_size_inches()[1]), fontsize=9
	)
	file = get_file_name(var, season, periods)
	savefig(output, file, title)


def main(type_, var, season, periods, inputs, sources, output):
	if type_ == "trend":
		name = f"{var}_trend"
	else:
		name = f"{var}_mean"
	indexes = [io.list_dataset(input_) for input_ in inputs]
	if type_ == "diff_multi":
		func = plot_diff_multi
	else:
		func = plot_generic
	func(
		type_,
		inputs,
		sources,
		output,
		var,
		name,
		season,
		periods,
		indexes=indexes,
	)


if __name__ == "__main__":
	if len(sys.argv) < 9:
		sys.stderr.write(sys.modules[__name__].__doc__)
		sys.exit(1)

	type_ = sys.argv[1]

	if type_ == "diff" and len(sys.argv) < 11:
		sys.stderr.write(sys.modules[__name__].__doc__)
		sys.exit(1)

	var = sys.argv[2]
	season = sys.argv[3]

	if type_ == "diff_multi":
		nperiods = int(sys.argv[4])
		nsources = int(sys.argv[5])
		n = 6
		periods = [
			[int(sys.argv[n + 2 * i]), int(sys.argv[n + 2 * i + 1])]
			for i in range(nperiods)
		]
		n += nperiods * 2
		inputs = sys.argv[n : (n + nsources * 2) : 2]
		sources = sys.argv[(n + 1) : (n + nsources * 2) : 2]
	else:
		period1 = [int(sys.argv[4]), int(sys.argv[5])]
		n = 6
		if type_ == "diff":
			start2 = int(sys.argv[6])
			end2 = int(sys.argv[7])
			period2 = [start2, end2]
			periods = [period1, period2]
			n += 2
		else:
			periods = [period1]
		inputs = [sys.argv[n]]
		sources = sys.argv[(n + 1) : -1]

	output = sys.argv[-1]

	if type_ not in ["mean", "trend", "diff", "diff_multi"]:
		raise ValueError(f"invalid type {type_!r}")

	main(type_, var, season, periods, inputs, sources, output)
